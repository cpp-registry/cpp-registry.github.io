---
import registry from "../../../../registry.json";
import Layout from "../../../layouts/Layout.astro";
import Star from "../../../assets/star.svg";
import CPPLOGO from "../../../assets/c++logo.svg";
import CLOGO from "../../../assets/clogo.svg";

import "../../../styles/global.css";

export function getStaticPaths() {
  return Object.values(registry).map((project) => ({
    params: {
      username: project.owner,
      repo: project.repo,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
---

<Layout
  description={project.description ?? `${project.repo} by ${project.owner}`}
>
  <main>
    <nav>
      <a href="/">C++ Registry</a>
      {" "}/{" "}
      <a href={`/~/${project.owner}`}>{project.owner}</a>
      {" "}/{" "}
      {project.repo}
    </nav>

    <h1>{project.repo}</h1>

    {project.description && <p>{project.description}</p>}

    <p>
      by <a href={`https://github.com/${project.owner}`}>
        {project.owner}
      </a>
    </p>

    {
      project.license && (
        <p>
          License: <strong>{project.license}</strong>
        </p>
      )
    }

    <!-- Programming Language + Logos -->
    {
      project.language && (
        <>
        <!--
          {project.language === "C++" && <CPPLOGO />}
          {project.language === "C" && <CLOGO />}
           -->

          <p>
            Language: <strong>{project.language}</strong>
          </p>
        </>
      )
    }

    {
      project.cppstd && (
        <p>
          Standard: <strong>C++{project.cppstd}</strong>
        </p>
      )
    }

    <a href={project.url} target="_blank" rel="noopener noreferrer">
      View on GitHub →
    </a>
    
    {
      project.stars && (
        <p>
          Github Stars: <strong>{project.stars}</strong> <Star />
        </p>
      )
    }

    {
      project.automatic_registered && (
        <p>
          <i>
            INFO: This project was registered automaticly, not by the owner of
            the project.
          </i>
        </p>
      )
    }
  </main>
</Layout>
