---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog — C++ Registry"
  description="News, updates and articles from the C++ Registry."
>
  <main class="blog-page">
    <header class="blog-header">
      <p class="eyebrow">C++ REGISTRY / <a href="/">Home</a></p>

      <h1>Blog.</h1>

      <p class="subtitle">News, updates and articles about the C++ Registry.</p>
    </header>

    <section class="blog-list">
      {
        posts.map((post) => (
          <a class="blog-post" href={`/blog/${post.id}/`}>
            <div class="blog-post-main">
              <h2>{post.data.title}</h2>

              <p>{post.data.description}</p>
            </div>

            <div class="blog-post-meta">
              <span>
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>

              <span>{post.data.author}</span>
            </div>
          </a>
        ))
      }
    </section>

    {
      posts.length === 0 && (
        <div class="no-results">
          <h2>No posts yet</h2>
          <p>Check back later.</p>
        </div>
      )
    }
  </main>
</Layout>
