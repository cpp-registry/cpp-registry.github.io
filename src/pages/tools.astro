---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Tools — C++ Registry"
  description="Useful tools and resources for C++ developers."
>
  <main class="content-page">
    <header class="content-header">
      <p class="eyebrow">C++ REGISTRY</p>

      <h1>Tools.</h1>

      <p class="subtitle">Useful tools and resources for C++ development.</p>
    </header>

    <section class="content-section">
      <div class="section-label">
        <span class="info-label">DEVELOPMENT</span>
      </div>

      <div class="link-list">
        <a
          class="tool-item"
          href="https://godbolt.org/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <h2>Compiler Explorer</h2>
            <p>
              Compile and inspect C++ code with different compilers and compiler
              versions directly in your browser.
            </p>
          </div>

          <span class="external-link">↗</span>
        </a>

        <a
          class="tool-item"
          href="https://cppinsights.io/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <h2>CppInsights</h2>
            <p>See what the compiler does with your modern C++ code.</p>
          </div>

          <span class="external-link">↗</span>
        </a>

        <a
          class="tool-item"
          href="https://quick-bench.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <h2>Quick Bench</h2>
            <p>
              Quickly benchmark C++ code and compare different implementations.
            </p>
          </div>

          <span class="external-link">↗</span>
        </a>
      </div>
    </section>

    <section class="content-section">
      <div class="section-label">
        <span class="info-label">DOCUMENTATION</span>
      </div>

      <div class="link-list">
        <a
          class="tool-item"
          href="https://en.cppreference.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <h2>cppreference</h2>
            <p>
              Comprehensive reference documentation for the C and C++ languages
              and standard libraries.
            </p>
          </div>

          <span class="external-link">↗</span>
        </a>

        <a
          class="tool-item"
          href="https://isocpp.org/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div>
            <h2>ISO C++</h2>
            <p>
              The official ISO C++ community website with news, standards
              information and resources.
            </p>
          </div>

          <span class="external-link">↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
